# ═══════════════════════════════════════════════════════════════════════
# Kalidash Vision / SpectraAI — variáveis de ambiente (backend)
# Copie para backend/.env e preencha. Só o backend lê estas chaves.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase (obrigatório) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_BUCKET_VIDEOS=videos

# ── Provedores de IA (Fase 13) ─────────────────────────────────────────
# Basta UMA chave. A cadeia de fallback pula os provedores sem chave.
# Ordem padrão: Claude (principal) → GPT → Groq → Gemini.
ANTHROPIC_API_KEY=      # Claude (principal)
OPENAI_API_KEY=         # GPT
GROQ_API_KEY=           # Groq
GEMINI_API_KEY=         # Gemini (aceita também GOOGLE_API_KEY)

# ── Configuração da cadeia de IA (opcional) ────────────────────────────
# Ordem de fallback (default abaixo):
# KV_AI_FALLBACK_ORDER=claude,gpt,groq,gemini
# Forçar UM provedor só (ignora a ordem/fallback):
# KV_AI_PROVIDER=claude
# Nº de retries por provedor em erros transitórios (429/5xx/timeout):
# KV_AI_RETRIES=2
# "thinking" do Claude na análise (Fase 14: default LIGADO; "0" desliga):
# KV_CLAUDE_THINKING=0

# ── Trava de orçamento por provedor (Fase 14) ──────────────────────────
# Teto MENSAL em USD por provedor. Ao atingir, o provedor é PULADO na cadeia
# de fallback (cai pro próximo); se TODOS estourarem, a chamada falha limpo.
# Defaults: claude=100, gpt=50, groq=30, gemini=30 (soma ≤ ~US$210/mês).
# 0 = sem teto pra aquele provedor.
# KV_AI_LIMITE_CLAUDE_USD=100
# KV_AI_LIMITE_GPT_USD=50
# KV_AI_LIMITE_GROQ_USD=30
# KV_AI_LIMITE_GEMINI_USD=30
# Override de preços (USD por 1M tokens [entrada, saída]) p/ o cálculo de custo:
# KV_AI_PRECOS_JSON={"claude-sonnet-5":[3,15],"claude-haiku-4-5":[1,5]}
# (Gasto por provedor no mês: GET /ai/uso — ledger na tabela Supabase ai_uso.)

# Override de modelo por provedor+tier (tiers: VISION, ANALISE, RAPIDO).
# Defaults: Claude = haiku-4-5 (vision/rapido) / sonnet-5 (analise);
#           GPT = gpt-4o-mini / gpt-4o; Gemini = gemini-2.0-flash;
#           Groq = llama-4-scout / gpt-oss-120b / llama-3.3-70b.
# KV_MODELO_CLAUDE_ANALISE=claude-sonnet-5
# KV_MODELO_CLAUDE_VISION=claude-haiku-4-5
# KV_MODELO_GPT_ANALISE=gpt-4o
# KV_MODELO_GEMINI_ANALISE=gemini-2.0-flash

# ── Tuning opcional do pipeline (Fase 14 relaxou os cortes da Fase 12) ─
# KV_INTERVALO_AMOSTRAGEM_S=5.0
# KV_VLM_MAX_LADO=1024
# KV_VLM_QUALIDADE=85
# KV_CLUSTER_MAX_DESC=200
# KV_TPM_GPT_OSS=7200
# KV_TPM_SCOUT=27000
# KV_RPM_GPT_OSS=25

# ── Outros (opcional) ──────────────────────────────────────────────────
# CORS_ORIGINS=*
