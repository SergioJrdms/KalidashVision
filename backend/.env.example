# ═══════════════════════════════════════════════════════════════════════
# Kalidash Vision / SpectraAI — variáveis de ambiente (backend)
# Copie para backend/.env e preencha. Só o backend lê estas chaves.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase (obrigatório) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_BUCKET_VIDEOS=videos

# ── Provedores de IA (Fase 13) ─────────────────────────────────────────
# Basta UMA chave. A cadeia de fallback pula os provedores sem chave.
# Ordem padrão: Claude (principal) → GPT → Groq → Gemini.
ANTHROPIC_API_KEY=      # Claude (principal)
OPENAI_API_KEY=         # GPT
GROQ_API_KEY=           # Groq
GEMINI_API_KEY=         # Gemini (aceita também GOOGLE_API_KEY)

# ── Configuração da cadeia de IA (opcional) ────────────────────────────
# Ordem de fallback (default abaixo):
# KV_AI_FALLBACK_ORDER=claude,gpt,groq,gemini
# Forçar UM provedor só (ignora a ordem/fallback):
# KV_AI_PROVIDER=claude
# Nº de retries por provedor em erros transitórios (429/5xx/timeout):
# KV_AI_RETRIES=2
# "thinking" do Claude na análise (default DESLIGADO — ligar pode esvaziar a
# saída JSON e quebrar o parse). "1" liga o adaptive e soma a folga abaixo:
# KV_CLAUDE_THINKING=1
# KV_CLAUDE_THINKING_BUDGET=8000   # tokens extras só p/ o pensamento quando ligado

# ── Trava de orçamento por provedor (Fase 14) ──────────────────────────
# Teto MENSAL em USD por provedor. Ao atingir, o provedor é PULADO na cadeia
# de fallback (cai pro próximo); se TODOS estourarem, a chamada falha limpo.
# Defaults: claude=100, gpt=50, groq=30, gemini=30 (soma ≤ ~US$210/mês).
# 0 = sem teto pra aquele provedor.
# KV_AI_LIMITE_CLAUDE_USD=100
# KV_AI_LIMITE_GPT_USD=50
# KV_AI_LIMITE_GROQ_USD=30
# KV_AI_LIMITE_GEMINI_USD=30
# Override de preços (USD por 1M tokens [entrada, saída]) p/ o cálculo de custo:
# KV_AI_PRECOS_JSON={"claude-sonnet-5":[3,15],"claude-haiku-4-5":[1,5]}
# (Gasto por provedor no mês: GET /ai/uso — ledger na tabela Supabase ai_uso.)

# Override de modelo por provedor+tier (tiers: VISION, ANALISE, RAPIDO).
# Defaults: Claude = haiku-4-5 (vision/rapido) / sonnet-5 (analise);
#           GPT = gpt-4o-mini / gpt-4o; Gemini = gemini-2.0-flash;
#           Groq = llama-4-scout / gpt-oss-120b / llama-3.3-70b.
# KV_MODELO_CLAUDE_ANALISE=claude-sonnet-5
# KV_MODELO_CLAUDE_VISION=claude-haiku-4-5
# KV_MODELO_GPT_ANALISE=gpt-4o
# KV_MODELO_GEMINI_ANALISE=gemini-2.0-flash

# ── Tuning opcional do pipeline (Fase 14 relaxou os cortes da Fase 12) ─
# KV_INTERVALO_AMOSTRAGEM_S=5.0
# KV_VLM_MAX_LADO=1024
# KV_VLM_QUALIDADE=85
# KV_CLUSTER_MAX_DESC=200
# KV_TPM_GPT_OSS=7200
# KV_TPM_SCOUT=27000
# KV_RPM_GPT_OSS=25

# ── Pareamento cam1/cam2 no lote (Fase 15) ─────────────────────────────
# Janela (segundos) p/ considerar cam1 e cam2 como PAR (dual-angle). Dentro
# da janela = par; fora = 2 solos. Default 360 (6 min).
# KV_LOTE_PAR_JANELA_S=360
# Carência (segundos) antes de processar um segmento SEM par como solo (Fase
# 39). O edge sobe a cam1 e depois a cam2 (minutos entre elas); sem carência,
# o pareamento podia solar a cam1 antes da cam2 chegar → 2 solos no lugar de 1
# par. Recém-chegados sem par esperam até isto; solos de verdade processam
# depois. Default 1200 (20 min). Suba se cam1/cam2 chegam em runs distantes.
# KV_LOTE_SOLO_GRACE_S=1200

# ── 1 evento PRINCIPAL por minuto (Fase 16) ────────────────────────────
# Reduz os ~100 eventos/vídeo a ~1 por minuto (a ação que resume o minuto) p/
# validação + métricas; os detalhados ficam como auditoria (principal=false).
# "off" volta ao comportamento antigo (todos os eventos vão pra validação).
# KV_PRINCIPAL_ENABLE=on
# KV_PRINCIPAL_BUCKET_S=60      # tamanho do bucket em segundos (60 = 1 min)
# KV_PRINCIPAL_DOMINANCIA=0.5   # share mínimo p/ escolher o dominante sem IA
#                               # (abaixo disso, 1 chamada de IA resume o minuto)

# ── Análise de padrões (Fase 24) ───────────────────────────────────────
# A tela de Padrões está "em breve" e a análise de padrões (LLM, ~3-5k tokens
# por rajada em analisar_padroes_processo + analisar_padroes_globais) fica
# DESLIGADA por padrão p/ cortar tokens. Nada é apagado — reative quando quiser:
#   KV_PADROES_ENABLE=on         # (default off) volta a gerar padrões

# ── Visão global + Chat do Prism (Fase 25) ─────────────────────────────
# Ambos "em breve" e DESLIGADOS por padrão p/ zerar tokens. Nada é apagado:
#   KV_INSIGHTS_GLOBAIS_ENABLE=on  # (default off) volta a gerar insights de portfólio
#   KV_PRISM_CHAT_ENABLE=on        # (default off) reativa o chat (respostas, título, sugestões)

# ── Análise focada no OPERADOR titular do posto (Fase 28) ──────────────
# Liga POR PROCESSO ao desenhar (em Configurações) uma zona com papel
# 'posto_operador' na câmera — a partir daí só o operador titular é analisado
# (transeuntes descartados na detecção), quem entra na área de interação vira
# evento de visita, e a ausência do operador vira 'posto_vazio' (desperdício,
# custo zero de token). A cam2 (lateral) confirma em profundidade quando também
# tem zona de posto desenhada. Sem zonas → pipeline idêntico ao anterior.
#   KV_OPERADOR_FILTRO_ENABLE=on   # kill-switch global (default on)
#   KV_OPERADOR_CONFIRMACAO=dupla  # dupla (cam1+cam2) | cam1 (só a frontal)
#   KV_POSTO_VAZIO_ENABLE=on       # sintetiza eventos de posto vazio
#   KV_CAM2_CONF=0.35              # confiança mínima do YOLO na cam2
#   KV_CAM2_CONFIRM_STRIDE=1       # confirmar 1 a cada N amostras (escape de CPU)
#   KV_CAM2_REBAIXA_MAX=0.8        # guardrail (Fase 30): se a cam2 negar mais
#                                  # que esta fração dos slots com operador
#                                  # (≥5 slots), ignora a cam2 no vídeo
#                                  # (desalinhamento/zona errada não zera tudo)
#   KV_OPERADOR_GAP_SLOTS=3        # ponte temporal (Fase 34): ausência de até
#                                  # N slots ENTRE duas presenças conta como
#                                  # presente (YOLO "pisca" na oclusão; sem a
#                                  # ponte cada piscada virava posto_vazio)
#   KV_OPERADOR_CONF=0.30          # RECALL (Fase 45): confiança mínima do YOLO
#                                  # SÓ em modo operador (fora dele = 0.45). O
#                                  # titular ocluso pela máquina/escuro fica com
#                                  # baixa confiança e sumia → posto_vazio FALSO.
#                                  # As zonas já descartam transeuntes, então
#                                  # cortar menos aqui só ajuda a não perdê-lo.
#   KV_OPERADOR_AREA_MIN_RATIO=0.0015  # idem p/ a ÁREA mínima do bbox em modo
#                                  # operador (fora dele = 0.005): operador
#                                  # parcialmente visível ocupa pouca área.

# ── Caso comercial: presença + produtividade do operador (V9) ─────────
# Kill switch comportamental. Default OFF: deployar o código não muda a
# medição em andamento. Ao ligar, o carimbo é forçado para versão 9, mesmo se
# uma env antiga ainda disser KV_VERSAO_INSTRUMENTO=8.
#   KV_PRODUTIVIDADE_OPERADOR_V9=off
# Orientação medida pela pose só entra no prompt e na conta depois de calibração
# visual por câmera. Mantenha off enquanto frente_maquina não estiver validado.
#   KV_ORIENTACAO_VERIFICADA=off
# Fuso do relógio gravado no nome dos segmentos enviados pelo edge.
#   KV_TZ=America/Sao_Paulo
# Pisos internos do selo "pronto para apresentação". Não viram duração na UI.
#   KV_PRODUTIVIDADE_MIN_LEITURAS=20
#   KV_PRODUTIVIDADE_FRESCOR_MIN=30

# ── Gate de repetição do VLM (Fase 23) ─────────────────────────────────
# A mudança de ação é o evento; a repetição do padrão só é contabilizada.
# Um classificador barato (pose local grátis + VLM binário só na dúvida)
# decide se a amostra repete a última analisada — se sim, herda o rótulo SEM
# chamar o VLM caro (o tempo continua 100% contabilizado). Corta tokens de
# amostragem (VISION) proporcional ao quanto o processo é repetitivo.
#   KV_GATE_ENABLE=on            # LIGA o gate (default off = pipeline atual)
#   KV_GATE_LIMIAR_IGUAL=0.12    # ≤ isso → repetição (sem VLM). Menor = mais rígido.
#   KV_GATE_LIMIAR_DIFERENTE=0.30 # ≥ isso → analisa direto. Entre os dois → VLM binário.
#   KV_GATE_PESO_POSE=0.6         # peso da pose (forma do corpo) no score
#   KV_GATE_PESO_MOV=0.4          # peso do movimento (absdiff do recorte)
#   KV_GATE_MOV_REF=18.0          # absdiff cinza considerado "muito diferente"

# ── Sugestões curadas por agregado (Fase 18) ───────────────────────────
# As sugestões passam a ser geradas 1× por rajada (no debouncer), sobre o
# AGREGADO do processo — não mais por vídeo (que empilhava dezenas). Modelo
# curado: dedup vs pendentes/dispensadas, não ressuscita dispensadas, apaga as
# pendentes não re-emitidas e mantém só as top-N mais relevantes.
# KV_SUGESTOES_MAX=6            # teto de sugestões PENDENTES vivas por processo

# ── Placar do processo + perguntas do gestor (Fase 19) ─────────────────
# Herói do dashboard: o processo comparado com o MELHOR dia dele mesmo, +
# anomalias transformadas em perguntas prontas (com horário real). Sem IA.
# O placar acende com 2+ dias; se só houver 1 dia, compara por SESSÃO (vídeo);
# com 1 sessão só, mostra a linha de base (modo referência).
# KV_PLACAR_MIN_UNIDADE_S=60     # observação mínima p/ uma unidade contar (só evita ruído)
# KV_PERGUNTA_PARADA_MIN_S=600   # parada contínua mínima p/ virar pergunta
# Ganho projetado ("rodando como o melhor dia, cada turno ganha +Xh"):
# KV_TURNO_H=8                   # horas por turno usadas na projeção
# KV_TURNOS_MES=22               # turnos por mês usados na projeção

# ── Seleção top-K no edge (Fase 22) ────────────────────────────────────
# A seleção acontece NO PI (edge_runner.py: SELECAO_QUOTA etc., .env do Pi).
# O backend só recebe a auditoria: campos opcionais `score` (0-100) e
# `selecao` (topk|calibracao|retry) no upload, gravados em `segmentos`.
# Rodar no Supabase: alter table segmentos add column if not exists score numeric;
#                    alter table segmentos add column if not exists selecao text;

# ── Outros (opcional) ──────────────────────────────────────────────────
# CORS_ORIGINS=*
